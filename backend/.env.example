# NitiSetu Backend Environment Configuration (Example)
PROJECT_NAME="NitiSetu API"
VERSION="1.1.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Comma-separated list of allowed origins for CORS (no trailing slashes)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Source A: NyayKosh Legal API (NeGD - Law as Code)
# NyayKosh public read endpoints do not require an API key
NYAYKOSH_BASE_URL="https://lawascode.negd.in/laac-api/v1"
NYAYKOSH_API_KEY=""
NYAYKOSH_TIMEOUT_SECONDS=8.0

# Source B: Scheme Dataset
SCHEMES_DATA_PATH="app/data/schemes.json"

# Source C: PDF Document Uploads
UPLOAD_DIRECTORY="uploads"
MAX_UPLOAD_SIZE_MB=10
